{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Dhong luxury dress product catalog item",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "price": { "type": "number" },
        "originalPrice": { "type": "number" },
        "category": { "type": "string", "minLength": 1, "maxLength": 128 },
        "sizes": { "type": "array", "description": "Available dress sizes" },
        "tags": { "type": "array", "description": "Dress tags" },
        "imageUrl": { "type": "string", "maxLength": 2048 },
        "description": { "type": "string", "maxLength": 5000 },
        "inStock": { "type": "boolean" },
        "featured": { "type": "boolean" },
        "sku": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "name", "price", "category", "imageUrl", "inStock"]
    },
    "Category": {
      "title": "Category",
      "description": "Store dress category",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["name"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase order",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "minLength": 1, "maxLength": 128 },
        "email": { "type": "string", "maxLength": 128 },
        "phone": { "type": "string", "minLength": 6, "maxLength": 32 },
        "address": { "type": "string", "minLength": 3, "maxLength": 512 },
        "city": { "type": "string", "minLength": 2, "maxLength": 64 },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "shipping": { "type": "number" },
        "total": { "type": "number" },
        "status": {
          "type": "string",
          "enum": ["Pending", "Confirmed", "Shipped", "Delivered", "Cancelled"]
        },
        "paymentMethod": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "customerName", "phone", "address", "city", "items", "subtotal", "total", "status", "paymentMethod"]
    },
    "Invoice": {
      "title": "Invoice",
      "description": "Confirmed order invoice",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "orderId": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 128 },
        "phone": { "type": "string", "maxLength": 32 },
        "total": { "type": "number" },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "orderId", "customerName", "total"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Authorized administrator",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "enum": ["admin"] },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["email", "role"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Public dress inventory items"
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Catalog categories"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Customer orders (PII protected)"
    },
    "/invoices/{invoiceId}": {
      "schema": "Invoice",
      "description": "Billing invoices (admin only)"
    },
    "/admins/{adminId}": {
      "schema": "Admin",
      "description": "Authorized administrator user records"
    }
  }
}
